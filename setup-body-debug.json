  "bodyHtml": "<script>;(function () {\n        var bg, fg\n        try {\n          bg = localStorage.getItem('comfy-splash-bg')\n          fg = localStorage.getItem('comfy-splash-fg')\n        } catch (_) {}\n        if (!bg || !fg) {\n          var isDark =\n            window.matchMedia &&\n            window.matchMedia('(prefers-color-scheme: dark)').matches\n          bg = isDark ? '#202020' : '#f5f5f5'\n          fg = isDark ? '#ffffff' : '#000000'\n        }\n        document.documentElement.style.setProperty('--bg-color', bg)\n        document.documentElement.style.setProperty('--fg-color', fg)\n        var el = document.getElementById('splash-loader')\n        if (el) {\n          el.style.background = bg\n          el.style.color = fg\n        }\n      })()</script><div id=\"vue-app\" data-v-app=\"\"><main class=\"relative size-full overflow-hidden\"><div data-v-ade4d41a=\"\" class=\"comfyui-body grid size-full overflow-hidden\"><div data-v-ade4d41a=\"\" id=\"comfyui-body-top\" class=\"comfyui-body-top\"><div id=\"cm-pb\"><div class=\"cm-pb-track\"><div class=\"cm-pb-bar nodes\"></div><div class=\"cm-pb-bar steps\"></div></div><div class=\"cm-pb-label\"><span class=\"cm-pb-dot\"></span><span class=\"cm-pb-text\">Idle</span><span class=\"cm-pb-eta\"></span></div></div></div><div data-v-ade4d41a=\"\" id=\"comfyui-body-bottom\" class=\"comfyui-body-bottom\"><div class=\"pysssss-image-feed pysssss-image-feed--bottom\" style=\"--max-size: 25; --img-sz: 4;\"><div class=\"pysssss-image-feed-menu\"><section class=\"sizing-menu\"><label class=\"size-control-handle\">↹ Resize Feed</label><div class=\"size-controls-flyout\"><section class=\"size-control feed-size-control\" title=\"Controls the maximum size of the image feed panel (25vh)\"><span>Feed Size...</span><input type=\"range\" min=\"10\" max=\"80\" style=\"\"></section><section class=\"size-control image-size-control\" title=\"Controls the number of columns in the feed (4 columns).\nClick label to set custom value.\"><a style=\"cursor: pointer; text-decoration: underline;\">Column count...</a><input type=\"range\" min=\"1\" max=\"10\" step=\"1\" style=\"\"></section></div></section><div class=\"pysssss-image-feed-btn-group\"><button class=\"pysssss-image-feed-btn clear-btn\">Clear</button><button class=\"pysssss-image-feed-btn hide-btn\">❌</button></div></div><div class=\"pysssss-image-feed-list\"></div></div></div><div data-v-ade4d41a=\"\" id=\"comfyui-body-left\" class=\"comfyui-body-left\"></div><div data-v-ade4d41a=\"\" id=\"comfyui-body-right\" class=\"comfyui-body-right\"></div><div data-v-ade4d41a=\"\" id=\"graph-canvas-container\" class=\"graph-canvas-container\"><div class=\"comfy-menu no-drag\" style=\"display: none;\"><div class=\"drag-handle comfy-menu-header\" style=\"overflow: hidden; position: relative; width: 100%; cursor: default;\"><span class=\"drag-handle\"></span><span class=\"comfy-menu-queue-size\">Queue size: 0</span><div class=\"comfy-menu-actions\"><button class=\"comfy-settings-btn\">⚙️</button><button class=\"comfy-settings-btn\" style=\"right: 16px; cursor: pointer; display: none;\">🖼️</button><button class=\"comfy-close-menu-btn\">×</button></div></div><button class=\"comfy-queue-btn\" id=\"queue-button\">Queue Prompt</button><div><label>Extra options<input type=\"checkbox\" style=\"\"></label></div><div id=\"extraOptions\" style=\"width: 100%; display: none;\"><div><label>Batch count</label><input id=\"batchCountInputNumber\" type=\"number\" min=\"1\" style=\"width: 35%; margin-left: 0.4em;\"><input id=\"batchCountInputRange\" type=\"range\" min=\"1\" max=\"100\" style=\"\"></div><div><label for=\"autoQueueCheckbox\">Auto Queue</label><input id=\"autoQueueCheckbox\" type=\"checkbox\" title=\"Automatically queue prompt when the queue size hits 0\" style=\"\"><div class=\"comfy-toggle-switch\" style=\"display: none;\"><label title=\"A new prompt will be queued as soon as the queue reaches 0\" class=\"comfy-toggle-selected\">instant<input name=\"autoQueueMode\" type=\"radio\" value=\"instant\" style=\"\"></label><label title=\"A new prompt will be queued when the queue is at 0 and the graph is/has changed\">change<input name=\"autoQueueMode\" type=\"radio\" va"
